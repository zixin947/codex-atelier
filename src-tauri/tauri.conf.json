{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Atelier",
  "version": "0.1.0",
  "identifier": "com.codexatelier.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/build-router.mjs && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Codex Atelier — 个人工作站",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-src 'self' atelier: http://atelier.localhost magpie: http://magpie.localhost; connect-src ipc: http://ipc.localhost; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [],
    "resources": {
      "binaries/atelier-router": "atelier-router",
      "../vendor/atelier/LICENSE": "licenses/atelier/LICENSE",
      "../vendor/atelier/THIRD_PARTY_NOTICES": "licenses/atelier/THIRD_PARTY_NOTICES",
      "../vendor/gpt-dragon-girl/": "gpt-dragon-girl/"
    }
  }
}
